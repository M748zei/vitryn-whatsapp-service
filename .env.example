# Port the bridge listens on
PORT=3001

# Shared secret — must match BRIDGE_SECRET in Next.js
BRIDGE_SECRET=change_me_to_a_strong_random_string

# URL of the Vitryn Next.js app (where /api/wa/webhook lives)
VITRYN_WEBHOOK_URL=https://vitryn.app

# Directory for session files (use a Railway persistent volume mounted here)
SESSIONS_DIR=/data/sessions
